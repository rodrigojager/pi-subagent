{
  "name": "@mystilleef/pi-subagent",
  "version": "0.13.0-rodrigo.5",
  "description": "Pi subagents with numbered runs and task-first progress cards, based on the SPAE extension",
  "author": "Lateef Alabi-Oki <mystilleef@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigojager/pi-subagent.git"
  },
  "bugs": {
    "url": "https://github.com/rodrigojager/pi-subagent/issues"
  },
  "homepage": "https://github.com/rodrigojager/pi-subagent#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "agent",
    "subagent",
    "orchestration",
    "ai",
    "llm"
  ],
  "module": "src/index.ts",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./roles": "./src/roles/index.ts"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=18"
  },
  "files": [
    "src",
    "README.md",
    "tsconfig.json",
    "assets/ui-preview.png",
    "scripts/import-agency-roles.ts",
    "docs/roles.md",
    "docs/roles-migration.md",
    "docs/custom-roles.md",
    "roles/custom",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/rodrigojager/pi-subagent/main/assets/ui-preview.png",
    "skills": [
      "./skills"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write --unsafe --error-on-warnings .",
    "migrate": "biome migrate --write",
    "coverage": "bun test --parallel --parallel-delay=0",
    "check": "bun lint && bun typecheck",
    "verify": "bun migrate && bun check && bun coverage",
    "pack:smoke": "bun scripts/pack-smoke.ts",
    "release": "sh -c 'npm version \"$1\" -m \"chore(release): %s\" && git push --follow-tags' --",
    "roles:import": "bun scripts/import-agency-roles.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "koffi": true,
    "protobufjs": true,
    "@google/genai": true
  },
  "private": true
}
